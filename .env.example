# Syarfani Akbar Portfolio V2 — environment (LOCAL dev)
# Copy to .env and fill with real values. NEVER commit this file.
# .env is gitignored.

# PostgreSQL (Neon) — pooled connection for the app runtime
DATABASE_URL="postgresql://user:password@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct connection for Prisma CLI (migrations) — no -pooler
DIRECT_URL="postgresql://user:password@HOST.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Auth.js
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Single admin account (used by `npm run admin:create`)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Vercel Blob
BLOB_READ_WRITE_TOKEN=""

# Public site URL — used for sitemap, robots, and Open Graph metadataBase.
# Set this to the deployed/site origin (no trailing slash), e.g. https://example.com
NEXT_PUBLIC_SITE_URL=""